# Weather Underground PWS contributor API key.
# Add the same value as repo secret WU_API_KEY for GitHub Actions.
# Typical cap: 1500 calls/day, 30/minute. Check usage at
# https://www.wunderground.com/member/api-keys
# The public site never uses this key (CI snapshot + Open-Meteo only).
WU_API_KEY=

# Optional overrides for src/config/station.json
# WU_STATION_ID=ICABAC4
# STATION_NAME=Cabacés
# STATION_REGION=Tarragona
# STATION_COUNTRY=ES
# STATION_LAT=41.25
# STATION_LON=0.73

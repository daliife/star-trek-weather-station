---
import WeatherConsole from '../components/WeatherConsole.astro';
import station from '../config/station.json';
import '@fontsource/antonio/latin-400.css';
import '@fontsource/antonio/latin-700.css';
import '../styles/lcars.css';

const title = `Star Trek Weather Station · ${station.name}`;
const description = `Weather from ${station.name}, drawn like a starship ops desk. Live conditions, forecast, and history on a TNG LCARS console. Fan project — not affiliated with Paramount or Weather Underground.`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (file: string) => new URL(`${base}${file}`, Astro.site).href;
const pageUrl = asset('');
const ogImage = `${asset('og.png')}?v=2`;
const touchIcon = asset('apple-touch-icon.png');
const faviconPng = asset('favicon-32.png');
const faviconSvg = asset('favicon.svg');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Star Trek Weather Station',
  alternateName: `LCARS ${station.name}`,
  description,
  url: pageUrl,
  image: ogImage,
  applicationCategory: 'WeatherApplication',
  operatingSystem: 'Web',
  inLanguage: ['en', 'ca', 'es'],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
});
---

<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="daliife" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#eb943a" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Star Trek Weather Station" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={faviconPng} type="image/png" sizes="32x32" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={touchIcon} sizes="180x180" />
    <link rel="image_src" href={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Star Trek Weather Station" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:url" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={`LCARS console showing current conditions at ${station.name}`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ca_ES" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`LCARS console showing current conditions at ${station.name}`} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <WeatherConsole />
  </body>
</html>

---
import { initial } from '../lib/ssr-snapshot';
import DataGrid from './DataGrid.astro';
import ForecastPanel from './ForecastPanel.astro';
import HistoryPanel from './HistoryPanel.astro';
import PrefsModal from './PrefsModal.astro';
import Readout from './Readout.astro';
---

<div class="console is-booting" data-state={initial.state} data-view="station" data-lang="en" data-units="metric">
  <h1 class="visually-hidden">Star Trek Weather Station · {initial.location}</h1>
  <div class="elbow elbow-nw">
    <div class="elbow-spine" aria-hidden="true"></div>
    <span class="elbow-fillet" aria-hidden="true"></span>
    <div class="elbow-arm seg seg-location">
      <span class="seg-k visually-hidden" data-bind="region">{initial.region}</span>
      <span data-bind="location">{initial.location}</span>
    </div>
  </div>

  <aside class="rail">
    <nav class="pills" data-i18n-aria="views" aria-label="Views">
      <button class="pill pill-nav pill-station is-active" type="button" data-view="station" aria-pressed="true" aria-current="page" aria-controls="panel-station">
        <span data-i18n="current">Now</span>
      </button>
      <button class="pill pill-nav pill-forecast" type="button" data-view="forecast" aria-pressed="false" aria-controls="panel-forecast">
        <span data-i18n="forecast">Forecast</span>
      </button>
      <button class="pill pill-nav pill-history" type="button" data-view="history" aria-pressed="false" aria-controls="panel-history">
        <span data-i18n="history">History</span>
      </button>
    </nav>
    <button class="pill pill-prefs" type="button" data-prefs-open aria-haspopup="dialog" aria-controls="prefs-dialog" aria-expanded="false">
      <span data-i18n="preferences">Preferences</span>
    </button>
  </aside>

  <header class="header">
    <div class="seg seg-id finger">
      <span class="seg-k visually-hidden" data-bind="stationKey">{initial.stationKey}</span>
      <span data-bind="stationId">{initial.stationId}</span>
    </div>
    <div class="seg seg-observed finger finger-last">
      <span class="seg-k visually-hidden" data-i18n="observed">Reading</span>
      <span data-bind="observed">{initial.observed}</span>
    </div>
    <div class="chrono">
      <span class="visually-hidden" data-i18n="localTime">Local time</span>
      <span data-bind="clock">00:00:00</span>
    </div>
  </header>

  <main class="stage">
    <div class="stage-body">
      <div class="panel panel-station" id="panel-station" data-panel="station" tabindex="-1">
        <h2 class="visually-hidden" data-i18n="current">Now</h2>
        <Readout />
        <DataGrid />
      </div>
      <ForecastPanel />
      <HistoryPanel />
    </div>
  </main>

  <div class="elbow elbow-sw">
    <div class="elbow-spine" aria-hidden="true"></div>
    <span class="elbow-fillet" aria-hidden="true"></span>
    <div class="elbow-arm seg seg-source">
      <span class="seg-k visually-hidden" data-i18n="source">Source</span>
      <span data-bind="source">{initial.source}</span>
    </div>
  </div>

  <footer class="footer">
    <div class="seg seg-link finger finger-last">
      <span class="seg-k visually-hidden" data-i18n="link">Connection</span>
      <span data-bind="linkStatus">{initial.linkStatus}</span>
    </div>
  </footer>

  <PrefsModal />
</div>

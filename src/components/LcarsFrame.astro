---
import DataGrid from './DataGrid.astro';
import LangToggle from './LangToggle.astro';
import Readout from './Readout.astro';
import UnitsToggle from './UnitsToggle.astro';
---

<div class="console" data-state="loading" data-lang="ca" data-units="metric">
  <aside class="rail">
    <div class="elbow elbow-top">
      <div class="elbow-block"></div>
    </div>
    <nav class="pills">
      <button class="pill pill-station is-active" type="button" disabled>
        <span data-i18n="station">Estació</span>
      </button>
      <LangToggle />
      <UnitsToggle />
      <button class="pill pill-offline" type="button" disabled>
        <span data-i18n="forecast">Previsió</span>
        <span class="pill-slot" data-i18n="offline">Fora de línia</span>
      </button>
      <button class="pill pill-offline" type="button" disabled>
        <span data-i18n="history">Històric</span>
        <span class="pill-slot" data-i18n="offline">Fora de línia</span>
      </button>
    </nav>
    <div class="elbow elbow-bot">
      <div class="elbow-block"></div>
    </div>
  </aside>

  <header class="header">
    <div class="seg seg-location" data-bind="location">Cabacés</div>
    <div class="seg seg-id" data-bind="stationId">ICABAC4</div>
    <div class="seg seg-meta" data-i18n="meteorology">Meteorologia</div>
    <div class="chrono" data-bind="clock">00:00:00</div>
  </header>

  <main class="stage">
    <div class="cascade" aria-hidden="true">
      <div class="cascade-bar"></div>
      <div class="cascade-bar"></div>
      <div class="cascade-bar"></div>
      <div class="cascade-bar"></div>
    </div>
    <Readout />
    <DataGrid />
  </main>

  <footer class="footer">
    <div class="seg seg-source" data-bind="source">WunderGround PWS</div>
    <div class="seg seg-station" data-bind="stationId">ICABAC4</div>
    <div class="seg seg-link" data-bind="linkStatus">En línia</div>
    <div class="seg seg-fetched" data-bind="fetchedAt">—</div>
    <p class="disclaimer" data-i18n="disclaimer">
      Treball de fans. No afiliat a Paramount, Star Trek ni Weather Underground.
    </p>
  </footer>
</div>

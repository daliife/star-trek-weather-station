<section class="datagrid">
  <div class="data-spine" aria-hidden="true"></div>
  <div class="data-body">
    <div class="row">
      <span class="row-label" data-i18n="humidity">Humitat</span>
      <span class="row-value" data-bind="humidity">—</span>
    </div>
    <div class="row">
      <span class="row-label" data-i18n="gust">Ràfega</span>
      <span class="row-value" data-bind="gust">—</span>
    </div>
    <div class="row">
      <span class="row-label" data-i18n="direction">Direcció</span>
      <span class="row-value"><span data-bind="direction">—</span> <span data-bind="cardinal"></span></span>
    </div>
  </div>
</section>

<section class="panel panel-history" data-panel="history" hidden>
  <header class="panel-head">
    <h2 class="visually-hidden" data-i18n="history">Històric</h2>
    <p class="panel-note" data-i18n="sampleNote">Dades simulades. Encara no hi ha sèrie real.</p>
  </header>

  <div class="history-board">
    <div class="history-cards">
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="yesterday">Ahir</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">Màx</span>
              <span class="hist-stat-v" data-bind="hyh">—</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Mín</span>
              <span class="hist-stat-v" data-bind="hyl">—</span>
            </div>
          </div>
        </div>
      </article>
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="week">7 dies</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">Màx</span>
              <span class="hist-stat-v" data-bind="hwh">—</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Mín</span>
              <span class="hist-stat-v" data-bind="hwl">—</span>
            </div>
          </div>
        </div>
      </article>
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="month">30 dies</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">Màx</span>
              <span class="hist-stat-v" data-bind="hmh">—</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Mín</span>
              <span class="hist-stat-v" data-bind="hml">—</span>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="panel-block history-series">
      <h3 class="block-label" data-i18n="series">Últims dies</h3>
      <div class="series-block">
        <div class="bar-strip">
          <div class="hist-col">
            <span class="hist-val" data-bind="hs0">—</span>
            <span class="hist-bar" data-bar="0"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs1">—</span>
            <span class="hist-bar" data-bar="1"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs2">—</span>
            <span class="hist-bar" data-bar="2"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs3">—</span>
            <span class="hist-bar" data-bar="3"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs4">—</span>
            <span class="hist-bar" data-bar="4"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs5">—</span>
            <span class="hist-bar" data-bar="5"></span>
          </div>
          <div class="hist-col">
            <span class="hist-val" data-bind="hs6">—</span>
            <span class="hist-bar" data-bar="6"></span>
          </div>
        </div>
        <div class="series-rail" aria-hidden="true"></div>
        <div class="series-keys">
          <span class="hist-col-k" data-bind="hs0k">—</span>
          <span class="hist-col-k" data-bind="hs1k">—</span>
          <span class="hist-col-k" data-bind="hs2k">—</span>
          <span class="hist-col-k" data-bind="hs3k">—</span>
          <span class="hist-col-k" data-bind="hs4k">—</span>
          <span class="hist-col-k" data-bind="hs5k">—</span>
          <span class="hist-col-k" data-bind="hs6k">—</span>
        </div>
      </div>
    </div>
  </div>
</section>

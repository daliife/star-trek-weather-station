---
import { initial } from '../lib/ssr-snapshot';
---

<section class="panel panel-history" id="panel-history" data-panel="history" hidden tabindex="-1">
  <header class="panel-head">
    <h2 class="visually-hidden" data-i18n="history">History</h2>
    <p class="panel-note" data-bind="seriesNote" hidden aria-live="polite"></p>
  </header>

  <div class="history-board">
    <div class="history-cards">
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="yesterday">Yesterday</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">High</span>
              <span class="hist-stat-v" data-bind="hyh">{initial.hyh}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Low</span>
              <span class="hist-stat-v" data-bind="hyl">{initial.hyl}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="rain">Rain</span>
              <span class="hist-stat-v" data-bind="hyr">{initial.hyr}</span>
            </div>
          </div>
        </div>
      </article>
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="week">7 days</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">High</span>
              <span class="hist-stat-v" data-bind="hwh">{initial.hwh}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Low</span>
              <span class="hist-stat-v" data-bind="hwl">{initial.hwl}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="rain">Rain</span>
              <span class="hist-stat-v" data-bind="hwr">{initial.hwr}</span>
            </div>
          </div>
        </div>
      </article>
      <article class="hist-card">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="hist-card-main">
          <span class="row-label" data-i18n="month">30 days</span>
          <div class="hist-card-stats">
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="high">High</span>
              <span class="hist-stat-v" data-bind="hmh">{initial.hmh}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="low">Low</span>
              <span class="hist-stat-v" data-bind="hml">{initial.hml}</span>
            </div>
            <div class="hist-stat">
              <span class="hist-stat-k" data-i18n="rain">Rain</span>
              <span class="hist-stat-v" data-bind="hmr">{initial.hmr}</span>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="panel-block history-series">
      <div class="series-block">
        <div class="bar-strip">
          {initial.lastDays.map((day, index) => (
            <div class="hist-col">
              <span class="hist-val" data-bind={`hs${index}`}>{day.v}</span>
              <span class="hist-bar" data-bar={String(index)} aria-hidden="true" style={`--h: ${day.h}`}></span>
            </div>
          ))}
        </div>
        <div class="series-rail" aria-hidden="true"></div>
        <div class="series-keys">
          {initial.lastDays.map((day, index) => (
            <span class="hist-col-k">
              <span data-bind={`hs${index}k`}>{day.k}</span>
              <span class="hist-col-n" data-bind={`hs${index}n`}>{day.n}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

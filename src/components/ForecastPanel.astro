---
import { initial } from '../lib/ssr-snapshot';
---

<section class="panel panel-forecast" id="panel-forecast" data-panel="forecast" hidden>
  <header class="panel-head">
    <h2 class="visually-hidden" data-i18n="forecast">Forecast</h2>
    <p class="panel-note" data-bind="seriesNote" hidden aria-live="polite"></p>
  </header>

  <div class="forecast-board">
    <div class="panel-block">
      <div class="data-cluster cluster-hourly">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="data-body" role="list">
          {initial.hourly.map((point, index) => (
            <div class="row" role="listitem">
              <span class="row-label" data-bind={`fx${index}t`}>{point.t}</span>
              <span class="row-value row-forecast">
                <span data-bind={`fx${index}`}>{point.v}</span>
                <span class="row-rain" data-bind={`fx${index}r`}>{point.r}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="panel-block">
      <div class="data-cluster cluster-daily">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="data-body" role="list">
          {initial.daily.map((day, index) => (
            <div class="row" role="listitem">
              <span class="row-label" data-bind={`fd${index}k`}>{day.k}</span>
              <span class="row-value row-range">
                <span class="range">
                  <span class="range-k" data-i18n="high">High</span>
                  <span data-bind={`fd${index}h`}>{day.h}</span>
                </span>
                <span class="range">
                  <span class="range-k" data-i18n="low">Low</span>
                  <span data-bind={`fd${index}l`}>{day.l}</span>
                </span>
                <span class="range range-rain">
                  <span class="range-k" data-i18n="rain">Rain</span>
                  <span data-bind={`fd${index}r`}>{day.r}</span>
                </span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

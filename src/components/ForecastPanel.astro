<section class="panel panel-forecast" data-panel="forecast" hidden>
  <header class="panel-head">
    <h2 class="visually-hidden" data-i18n="forecast">Forecast</h2>
    <p class="panel-note" data-bind="seriesNote" hidden></p>
  </header>

  <div class="forecast-board">
    <div class="panel-block">
      <h3 class="block-label" data-i18n="hourly">Hourly</h3>
      <div class="data-cluster cluster-hourly">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="data-body">
          <div class="row">
            <span class="row-label" data-bind="fx0t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx0">—</span>
              <span class="row-rain" data-bind="fx0r"></span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fx1t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx1">—</span>
              <span class="row-rain" data-bind="fx1r"></span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fx2t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx2">—</span>
              <span class="row-rain" data-bind="fx2r"></span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fx3t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx3">—</span>
              <span class="row-rain" data-bind="fx3r"></span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fx4t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx4">—</span>
              <span class="row-rain" data-bind="fx4r"></span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fx5t">—</span>
            <span class="row-value row-forecast">
              <span data-bind="fx5">—</span>
              <span class="row-rain" data-bind="fx5r"></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="panel-block">
      <h3 class="block-label" data-i18n="daily">Daily</h3>
      <div class="data-cluster cluster-daily">
        <div class="data-spine" aria-hidden="true"></div>
        <div class="data-body">
          <div class="row">
            <span class="row-label" data-bind="fd0k">Today</span>
            <span class="row-value row-range">
              <span class="range">
                <span class="range-k" data-i18n="high">High</span>
                <span data-bind="fd0h">—</span>
              </span>
              <span class="range">
                <span class="range-k" data-i18n="low">Low</span>
                <span data-bind="fd0l">—</span>
              </span>
              <span class="range range-rain">
                <span class="range-k" data-i18n="rain">Rain</span>
                <span data-bind="fd0r">—</span>
              </span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fd1k">Tomorrow</span>
            <span class="row-value row-range">
              <span class="range">
                <span class="range-k" data-i18n="high">High</span>
                <span data-bind="fd1h">—</span>
              </span>
              <span class="range">
                <span class="range-k" data-i18n="low">Low</span>
                <span data-bind="fd1l">—</span>
              </span>
              <span class="range range-rain">
                <span class="range-k" data-i18n="rain">Rain</span>
                <span data-bind="fd1r">—</span>
              </span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fd2k">+2</span>
            <span class="row-value row-range">
              <span class="range">
                <span class="range-k" data-i18n="high">High</span>
                <span data-bind="fd2h">—</span>
              </span>
              <span class="range">
                <span class="range-k" data-i18n="low">Low</span>
                <span data-bind="fd2l">—</span>
              </span>
              <span class="range range-rain">
                <span class="range-k" data-i18n="rain">Rain</span>
                <span data-bind="fd2r">—</span>
              </span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fd3k">+3</span>
            <span class="row-value row-range">
              <span class="range">
                <span class="range-k" data-i18n="high">High</span>
                <span data-bind="fd3h">—</span>
              </span>
              <span class="range">
                <span class="range-k" data-i18n="low">Low</span>
                <span data-bind="fd3l">—</span>
              </span>
              <span class="range range-rain">
                <span class="range-k" data-i18n="rain">Rain</span>
                <span data-bind="fd3r">—</span>
              </span>
            </span>
          </div>
          <div class="row">
            <span class="row-label" data-bind="fd4k">+4</span>
            <span class="row-value row-range">
              <span class="range">
                <span class="range-k" data-i18n="high">High</span>
                <span data-bind="fd4h">—</span>
              </span>
              <span class="range">
                <span class="range-k" data-i18n="low">Low</span>
                <span data-bind="fd4l">—</span>
              </span>
              <span class="range range-rain">
                <span class="range-k" data-i18n="rain">Rain</span>
                <span data-bind="fd4r">—</span>
              </span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

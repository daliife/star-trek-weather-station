<section class="readout" aria-live="polite">
  <div class="status-pill" data-bind="opsStatus">Nominal</div>
  <div class="temp-line">
    <span class="temp" data-bind="temp">—</span>
    <span class="temp-unit" data-bind="tempUnit">°C</span>
  </div>
  <div class="feels">
    <span class="feels-label" data-i18n="feelsLike">Sensació</span>
    <span data-bind="feels">—</span>
  </div>
  <div class="wind-line">
    <span class="wind-label" data-i18n="wind">Vent</span>
    <span data-bind="wind">—</span>
    <span data-bind="windUnit"></span>
  </div>
</section>

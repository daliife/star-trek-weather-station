---
import { initial } from '../lib/ssr-snapshot';
---

<section class="readout">
  <div class="status-pill" data-bind="opsStatus" aria-live="polite" aria-atomic="true">{initial.opsStatus}</div>
  <div class="temp-block">
    <span class="metric-label" data-i18n="airTemp">Temperature</span>
    <div class="temp-line">
      <span class="temp" data-bind="temp">{initial.temp}</span>
      <span class="temp-unit" data-bind="tempUnit">{initial.tempUnit}</span>
    </div>
  </div>
  <div class="metric-pair">
    <div class="data-spine" aria-hidden="true"></div>
    <div class="metric-tiles">
      <div class="metric-tile">
        <span class="metric-label" data-i18n="feelsLike">Feels like</span>
        <span class="metric-value" data-bind="feels">{initial.feels}</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label" data-i18n="wind">Wind</span>
        <span class="metric-value">
          <span data-bind="wind">{initial.wind}</span>
          <span class="metric-unit" data-bind="windUnit">{initial.windUnit}</span>
        </span>
      </div>
      <div class="metric-tile">
        <span class="metric-label" data-i18n="sunrise">Sunrise</span>
        <span class="metric-value" data-bind="sunrise">{initial.sunrise}</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label" data-i18n="sunset">Sunset</span>
        <span class="metric-value" data-bind="sunset">{initial.sunset}</span>
      </div>
    </div>
  </div>
</section>

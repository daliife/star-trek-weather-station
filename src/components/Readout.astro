<section class="readout" aria-live="polite">
  <div class="status-pill visually-hidden" data-bind="opsStatus">Normal</div>
  <div class="temp-block">
    <span class="metric-label" data-i18n="airTemp">Temperature</span>
    <div class="temp-line">
      <span class="temp" data-bind="temp">—</span>
      <span class="temp-unit" data-bind="tempUnit">°C</span>
    </div>
  </div>
  <div class="metric-pair">
    <div class="data-spine" aria-hidden="true"></div>
    <div class="metric-tiles">
      <div class="metric-tile">
        <span class="metric-label" data-i18n="feelsLike">Feels like</span>
        <span class="metric-value" data-bind="feels">—</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label" data-i18n="wind">Wind</span>
        <span class="metric-value">
          <span data-bind="wind">—</span>
          <span class="metric-unit" data-bind="windUnit"></span>
        </span>
      </div>
    </div>
  </div>
  <div class="sun-row">
    <div class="sun-cell">
      <span class="sun-k">Sun ↑</span>
      <span class="sun-v" data-bind="sunrise">—</span>
    </div>
    <div class="sun-cell">
      <span class="sun-k">Sun ↓</span>
      <span class="sun-v" data-bind="sunset">—</span>
    </div>
  </div>
</section>
